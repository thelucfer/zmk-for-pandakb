#include <behaviors.dtsi>
#include <dt-bindings/zmk/backlight.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/rgb.h>

/ {
    behaviors {
        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_MODS";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick_tap_ms = <0>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;

            quick-tap-ms = <180>;
            global-quick-tap;
        };

        ltq: ltq {
            compatible = "zmk,behavior-hold-tap";
            label = "LTQ";
            bindings = <&mo>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <600>;
            global-quick-tap;
            quick-tap-ms = <400>;
        };

        td_arrow_fn: td_arrow_fn {
            compatible = "zmk,behavior-tap-dance";
            label = "TD_ARROW_FN";
            #binding-cells = <0>;
            tapping-term-ms = <350>;
            bindings = <&kp GREATER_THAN>, <&arrow_fn>;
        };

        td_left: td_left {
            compatible = "zmk,behavior-tap-dance";
            label = "TD_LEFT";
            #binding-cells = <0>;
            tapping-term-ms = <350>;
            bindings = <&kp LEFT>, <&kp LA(LEFT)>, <&kp LG(LEFT)>;
        };

        td_right: td_right {
            compatible = "zmk,behavior-tap-dance";
            label = "TD_RIGHT";
            #binding-cells = <0>;
            tapping-term-ms = <350>;
            bindings = <&kp RIGHT>, <&kp LA(RIGHT)>, <&kp LG(RIGHT)>;
        };

        td_up: td_up {
            compatible = "zmk,behavior-tap-dance";
            label = "TD_UP";
            #binding-cells = <0>;
            tapping-term-ms = <350>;
            bindings = <&kp UP_ARROW>, <&kp LA(UP_ARROW)>, <&kp LG(UP_ARROW)>;
        };

        td_down: td_down {
            compatible = "zmk,behavior-tap-dance";
            label = "TD_DOWN";
            #binding-cells = <0>;
            tapping-term-ms = <350>;
            bindings = <&kp DOWN>, <&kp LA(DOWN_ARROW)>, <&kp LG(DOWN)>;
        };
    };

    combos {
        compatible = "zmk,combos";

        left_bkt {
            bindings = <&kp LEFT_BRACKET>;
            key-positions = <4 3>;
            timeout-ms = <50>;
        };

        right_bkt {
            bindings = <&kp RBKT>;
            key-positions = <7 8>;
            timeout-ms = <50>;
        };

        left_par {
            bindings = <&kp LEFT_PARENTHESIS>;
            key-positions = <15 16>;
            timeout-ms = <50>;
        };

        right_par {
            bindings = <&kp RIGHT_PARENTHESIS>;
            key-positions = <19 20>;
            timeout-ms = <50>;
        };

        left_brace {
            bindings = <&kp LEFT_BRACE>;
            key-positions = <27 28>;
            timeout-ms = <50>;
        };

        right_brace {
            bindings = <&kp RIGHT_BRACE>;
            key-positions = <32 31>;
            timeout-ms = <50>;
        };

        bac {
            bindings = <&kp BACKSLASH>;
            key-positions = <5 6>;
        };

        pipe {
            bindings = <&kp PIPE>;
            key-positions = <17 18>;
        };

        less_than {
            bindings = <&kp LESS_THAN>;
            key-positions = <13 14>;
        };

        greater_than {
            bindings = <&td_arrow_fn>;
            key-positions = <21 22>;
        };
    };

    macros {
        arrow_fn: arrow_fn {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp EQUAL &kp GT>;
            label = "ARROW_FN";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&kp GRAVE  &kp Q           &kp W           &kp E           &kp R             &kp T        &kp Y        &kp U         &kp I          &kp O            &kp P               &kp BSPC
&kp EQUAL  &hm LEFT_GUI A  &hm LEFT_ALT S  &hm LCTRL D     &hm LEFT_SHIFT F  &kp G        &kp H        &hm RSHIFT J  &hm RCTRL K    &hm RIGHT_ALT L  &hm RGUI SEMICOLON  &kp SQT
&kp LSHFT  &kp Z           &kp X           &kp C           &kp V             &kp B        &kp N        &kp M         &kp COMMA      &kp DOT          &kp FSLH            &kp BACKSLASH
                                           &kp LEFT_SHIFT  &lt 4 TAB         &lt 2 SPACE  &lt 1 ENTER  &mo 3         &kp BACKSPACE
            >;
        };

        num_layer {
            bindings = <
&kp ESCAPE  &kp N9        &kp N0  &kp MINUS  &kp EQUAL  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans      &kp N5        &kp N6  &kp N7     &kp N8     &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans      &kp NUMBER_1  &kp N2  &kp N3     &kp N4     &trans  &trans  &trans  &trans  &trans  &trans  &trans
                                  &trans     &trans     &trans  &trans  &trans  &trans
            >;
        };

        nav_layer {
            bindings = <
&kp ESCAPE  &trans  &trans  &trans  &trans  &trans  &trans  &kp F1    &kp F2    &kp F3  &kp F4     &trans
&trans      &trans  &trans  &trans  &trans  &trans  &trans  &td_left  &td_down  &td_up  &td_right  &trans
&trans      &trans  &trans  &trans  &trans  &trans  &trans  &kp F5    &kp F6    &kp F7  &kp F8     &trans
                            &trans  &trans  &trans  &trans  &trans    &trans
            >;
        };

        sym_layer {
            bindings = <
&kp GRAVE      &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp MINUS      &kp EQUAL     &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &trans  &trans  &trans  &trans  &trans
&kp PIPE       &kp PERCENT           &kp CARET              &kp AMPERSAND  &kp ASTERISK  &kp LEFT_BRACE        &kp RIGHT_BRACE        &trans  &trans  &trans  &trans  &trans
&kp BACKSLASH  &kp EXCL              &kp AT                 &kp HASH       &kp DOLLAR    &kp LEFT_BRACKET      &kp RIGHT_BRACKET      &trans  &trans  &trans  &trans  &trans
                                                            &trans         &trans        &trans                &trans                 &trans  &trans
            >;
        };

        utils_layer {
            bindings = <
&trans  &trans  &trans   &trans   &trans   &trans  &trans  &bt BT_SEL 0      &bt BT_SEL 1     &bt BT_SEL 3     &bt BT_SEL 4  &trans
&trans  &trans  &trans   &trans   &trans   &trans  &trans  &kp C_PLAY_PAUSE  &kp K_PREV       &kp C_NEXT       &trans        &trans
&trans  &kp F9  &kp F10  &kp F11  &kp F12  &trans  &trans  &rgb_ug RGB_TOG   &rgb_ug RGB_BRD  &rgb_ug RGB_BRI  &bl BL_TOG    &trans
                         &trans   &trans   &trans  &trans  &trans            &trans
            >;
        };
    };
};
